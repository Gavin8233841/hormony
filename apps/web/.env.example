# 模型 API 配置（OpenAI 兼容接口）
# Agent 创新方向不限模型 API，可自由选择
MODEL_API_KEY=
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=doubao-seed-2-1-pro-260628
MODEL_TIMEOUT_MS=60000

# 若使用国内模型服务，示例：
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus

# CORS 允许的前端来源白名单（逗号分隔）
# 默认：http://localhost:3000,http://10.0.2.2:3000（本地开发 + 鸿蒙模拟器）
# 生产环境请替换为实际前端域名，例如：https://app.example.com
ORIGIN_ALLOWLIST=http://localhost:3000,http://10.0.2.2:3000

# 运行状态持久化。生产环境必须挂载持久卷并使用卷内绝对路径。
APP_STATE_PERSISTENCE=on
APP_STATE_FILE=/data/hongxueban-state.json
